{
  "name": "Freshman SQL Lab (PostgreSQL)",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "initializeCommand": "bash Database_basics_postgress/.devcontainer/initialize.sh",
  "forwardPorts": [
    5432,
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Adminer (DB UI)",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "5432": {
      "label": "PostgreSQL (loopback only)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  }
}
